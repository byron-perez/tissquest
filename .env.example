# Web application
PORT=8080
RUN_MIGRATIONS=false
GIN_MODE=release

# PostgreSQL (Koyeb/Neon)
DATABASE_HOST=your-database-host.example.com
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=your_database_name
DATABASE_PORT=5432
DATABASE_SSLMODE=require

# Supabase Storage (used by the local tile-pipeline CLI only)
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_BUCKET=tissquest-media
S3_ACCESS_KEY_ID=<supabase-s3-access-key>
S3_SECRET_ACCESS_KEY=<supabase-s3-secret-key>
S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/tissquest-media
S3_FORCE_PATH_STYLE=true
